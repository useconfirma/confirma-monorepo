---
/*
 * Ilustração isométrica do fluxo, em traço: o sistema da clínica cria o
 * agendamento, o Confirma envia a mensagem pelo WhatsApp, o paciente responde
 * 1 e o sistema recebe appointment.confirmed. Dados fictícios, seguindo
 * docs/specs/api.md (API-11 e API-13). O texto essencial está no hero; aqui
 * ele apenas ilustra. Cada painel é desenhado plano e projetado por PLANE.
 */
const plane = (x: number, y: number) => `matrix(0.866 0.5 0 1 ${x} ${y})`;
---

<svg
    class="ill mx-auto block h-auto w-full max-w-[40rem]"
    viewBox="0 0 600 560"
    role="img"
    aria-labelledby="ill-title ill-desc"
>
    <title id="ill-title">Fluxo de uma confirmação no Confirma</title>
    <desc id="ill-desc">
        O sistema da clínica envia POST /appointments e recebe 202 queued. O
        Confirma envia a mensagem pelo WhatsApp com nome, data e hora da
        consulta. O paciente responde 1 e o sistema da clínica recebe o webhook
        appointment.confirmed com estado confirmed.
    </desc>

    <!-- Chão -->
    <g class="stroke-cinza-verde-claro" fill="none">
        <path d="M24 392 L200 304 M60 470 L250 375 M96 536 L230 469"></path>
        <path d="M480 60 V 250 M540 150 V 330 M480 250 L560 290"></path>
        <path d="M250 520 L330 560 M20 300 L120 350"></path>
    </g>

    <!-- Telefone do paciente -->
    <g class="ill-part" style="--i: 1">
        <g transform={plane(310, 4)}>
            <rect
                x="0"
                y="0"
                width="190"
                height="370"
                rx="28"
                class="fill-surface stroke-ink"
            ></rect>
        </g>
        <g transform={plane(300, 10)}>
            <rect
                x="0"
                y="0"
                width="190"
                height="370"
                rx="28"
                class="fill-surface stroke-ink"
            ></rect>
            <rect
                x="9"
                y="9"
                width="172"
                height="352"
                rx="20"
                class="fill-surface stroke-line"
            ></rect>
            <rect
                x="66"
                y="20"
                width="58"
                height="14"
                rx="7"
                class="fill-line"
            ></rect>

            <text x="24" y="60" class="t-label">
                Clínica Teste
            </text>
            <text x="24" y="74" class="t-small">
                WhatsApp
            </text>
            <circle
                cx="158"
                cy="62"
                r="9"
                class="fill-surface stroke-line-strong"
            ></circle>
            <path d="M18 86 H172" class="stroke-line"></path>

            <rect
                x="20"
                y="98"
                width="136"
                height="94"
                rx="10"
                class="fill-surface stroke-ink"
            ></rect>
            <text x="30" y="117" class="t-body">
                Olá, Paciente Teste.
            </text>
            <text x="30" y="132" class="t-body">
                Consulta de teste
            </text>
            <text x="30" y="147" class="t-body">
                04/11 às 18:00.
            </text>
            <text x="30" y="166" class="t-body t-strong">
                Responda 1 ou 2.
            </text>
            <text x="146" y="184" class="t-small" text-anchor="end">
                09:00
            </text>

            <rect
                x="98"
                y="206"
                width="72"
                height="40"
                rx="10"
                class="fill-verde-claro stroke-verde"
            ></rect>
            <text x="112" y="233" class="t-reply">
                1
            </text>
            <path
                class="ill-check stroke-verde"
                pathLength="1"
                d="M134 228 l4 4 l7 -8 M142 228 l4 4 l7 -8"
                fill="none"
            ></path>

            <rect
                x="20"
                y="266"
                width="92"
                height="9"
                rx="4.5"
                class="fill-line"
            ></rect>
            <rect
                x="20"
                y="283"
                width="58"
                height="9"
                rx="4.5"
                class="fill-line"
            ></rect>

            <rect
                x="20"
                y="320"
                width="150"
                height="28"
                rx="14"
                class="fill-surface stroke-line"
            ></rect>
            <circle cx="155" cy="334" r="8" class="fill-verde"></circle>
        </g>
    </g>

    <!-- Agendamento criado pelo sistema da clínica -->
    <g class="ill-part" style="--i: 0">
        <g transform={plane(156, 106)}>
            <rect
                x="0"
                y="0"
                width="200"
                height="124"
                rx="12"
                class="fill-surface stroke-ink"
            ></rect>
        </g>
        <g transform={plane(150, 110)}>
            <rect
                x="0"
                y="0"
                width="200"
                height="124"
                rx="12"
                class="fill-surface stroke-ink"
            ></rect>
            <text x="16" y="26" class="t-mono">
                <tspan class="fill-verde">POST</tspan> /appointments
            </text>
            <path d="M12 38 H188" class="stroke-line"></path>
            <text x="16" y="58" class="t-key">
                patientName
            </text>
            <text x="96" y="58" class="t-body">
                Paciente Teste
            </text>
            <text x="16" y="78" class="t-key">
                scheduledAt
            </text>
            <text x="96" y="78" class="t-body">
                04/11 18:00
            </text>
            <text x="16" y="98" class="t-key">
                externalId
            </text>
            <rect
                x="96"
                y="91"
                width="72"
                height="8"
                rx="2"
                class="fill-ink"
            ></rect>

            <rect
                x="-22"
                y="114"
                width="108"
                height="24"
                rx="3"
                class="fill-ink"
            ></rect>
            <text x="-12" y="130" class="t-mono t-on-ink">
                202 · queued
            </text>
        </g>
    </g>

    <!-- Ligações -->
    <g class="stroke-cinza-verde" fill="none" stroke-dasharray="4 4">
        <path d="M212 304 V 392"></path>
        <path d="M246 404 L300 377"></path>
        <path d="M246 458 L318 422"></path>
    </g>
    <g class="fill-cinza-verde">
        <circle cx="212" cy="304" r="2.5"></circle>
        <circle cx="300" cy="377" r="2.5"></circle>
        <circle cx="318" cy="422" r="2.5"></circle>
    </g>

    <!-- Confirma -->
    <g class="ill-part" style="--i: 2">
        <g transform={plane(176, 362)}>
            <rect
                x="0"
                y="0"
                width="82"
                height="82"
                rx="18"
                class="fill-surface stroke-ink"
            ></rect>
        </g>
        <g transform={plane(170, 366)}>
            <rect
                x="0"
                y="0"
                width="82"
                height="82"
                rx="18"
                class="fill-surface stroke-ink"
            ></rect>
            <g transform="translate(8 2)">
                <rect
                    x="10"
                    y="14"
                    width="46"
                    height="38"
                    rx="11"
                    class="fill-ink"
                ></rect>
                <path d="M18 51 L14 67 L32 52 Z" class="fill-ink"></path>
                <polyline
                    points="22,33 31,42 45,25"
                    fill="none"
                    class="stroke-nevoa"
                    stroke-width="5.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                ></polyline>
            </g>
            <text x="0" y="102" class="t-mono">
                Confirma
            </text>
        </g>
    </g>

    <!-- Webhook recebido pelo sistema da clínica -->
    <g class="ill-part" style="--i: 3">
        <g transform={plane(324, 296)}>
            <rect
                x="0"
                y="0"
                width="230"
                height="126"
                rx="12"
                class="fill-surface stroke-ink"
            ></rect>
        </g>
        <g transform={plane(318, 300)}>
            <rect
                x="0"
                y="0"
                width="230"
                height="126"
                rx="12"
                class="fill-surface stroke-ink"
            ></rect>
            <text x="16" y="27" class="t-mono">
                appointment.confirmed
            </text>
            <circle cx="206" cy="22" r="10" class="fill-verde"></circle>
            <path
                class="ill-check stroke-branco"
                pathLength="1"
                d="M201.5 22 l3.5 3.5 l6 -7"
                fill="none"
                stroke-width="2"
            ></path>
            <path d="M12 40 H218" class="stroke-line"></path>
            <text x="16" y="62" class="t-key">
                state
            </text>
            <rect
                x="92"
                y="50"
                width="76"
                height="18"
                rx="9"
                class="fill-verde"
            ></rect>
            <text x="102" y="63" class="t-mono t-chip">
                confirmed
            </text>
            <text x="16" y="86" class="t-key">
                externalId
            </text>
            <rect
                x="92"
                y="79"
                width="96"
                height="8"
                rx="2"
                class="fill-line"
            ></rect>
            <text x="16" y="110" class="t-key">
                signature
            </text>
            <text x="92" y="110" class="t-mono t-sm">
                sha256=…
            </text>
        </g>
    </g>
</svg>

<style>
    .ill :is(rect, path, circle, polyline) {
        vector-effect: non-scaling-stroke;
        stroke-width: 1.25;
    }

    .ill .ill-check {
        stroke-width: 1.75;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .ill polyline {
        stroke-width: 3.5;
    }

    .ill text {
        fill: var(--color-ink);
        font-family: var(--font-sans);
    }

    .t-label {
        font-size: 12px;
        font-weight: 600;
    }

    .t-body {
        font-size: 10.5px;
    }

    .t-strong {
        font-weight: 600;
    }

    .ill .t-small,
    .ill .t-key {
        fill: var(--color-ink-muted);
        font-size: 9px;
    }

    .ill .t-key,
    .ill .t-mono,
    .ill .t-reply {
        font-family: var(--font-mono);
    }

    .t-mono {
        font-size: 11px;
        font-weight: 500;
    }

    .t-sm {
        font-size: 9.5px;
    }

    .t-reply {
        font-size: 17px;
        font-weight: 500;
    }

    .ill .t-on-ink,
    .ill .t-chip {
        fill: var(--color-branco);
    }

    .t-chip {
        font-size: 9.5px;
    }

    @media (prefers-reduced-motion: no-preference) {
        .ill-part {
            animation: var(--animate-rise);
            animation-delay: calc(var(--i) * 160ms + 200ms);
        }

        .ill-check {
            stroke-dasharray: 1;
            animation: var(--animate-check);
            animation-delay: 1s;
        }
    }
</style>
