{
    "singleQuote": true,
    "semi": true,
    "tabWidth": 4,
    "printWidth": 80,
    "trailingComma": "all",
    "endOfLine": "lf",
    "plugins": ["prettier-plugin-astro", "prettier-plugin-tailwindcss"],
    "overrides": [
        {
            "files": "*.astro",
            "options": {
                "parser": "astro"
            }
        }
    ]
}
